{
  "name": "sdvx.net",
  "version": "1.0.1",
  "description": "SOUND VOLTEX Redirector",
  "keywords": [],
  "author": "anon5r",
  "license": "None",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.11.0"
  },
  "workspaces": [
    "pages",
    "firebase/functions"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "dev:pages": "pnpm --filter @sdvx/pages dev",
    "build:pages": "pnpm --filter @sdvx/pages build",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter @sdvx/pages typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
